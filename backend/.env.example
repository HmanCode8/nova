# ===== 后端服务（仅本地监听）=====
HOST=127.0.0.1
PORT=8000

# ===== LLM（OpenAI 兼容协议，默认 DeepSeek）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.7

# ===== Tavily 联网搜索 =====
TAVILY_API_KEY=
# 运行时以设置面板（sqlite app_config）为准，这里只作为首次默认值
ENABLE_WEB_SEARCH=true

# ===== 本地语音（可选，全部有默认值）=====
# faster-whisper 模型尺寸：tiny / base / small / medium（默认 base）
# NOVA_WHISPER_MODEL=base
# 模型下载镜像（默认 ModelScope，国内可直连）
# NOVA_WHISPER_MIRROR=https://modelscope.cn/models
# 模型缓存目录（默认 %APPDATA%/NovaSecretary/models）
# NOVA_MODEL_DIR=
# piper 中文语音下载源（默认先试 hf-mirror 再试 HuggingFace）
# NOVA_PIPER_BASE_URL=

# ===== 视觉理解模型（可选，OpenAI 兼容多模态）=====
# 本机 Ollama 可留空；远程 API 需填写
# VL_API_KEY=
# VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VL_MODEL_NAME=qwen-vl-max

# ===== 真实服务数据源（阶段2.5）=====
# 邮件：mock（本地演示） / imap（飞书邮箱 IMAP+SMTP）
NOVA_MAIL_PROVIDER=mock
# 日历：mock（本地演示） / feishu（飞书日历，官方 lark-mcp）
NOVA_CALENDAR_PROVIDER=mock

# 飞书邮箱：MAIL_PASSWORD 填「客户端专用密码」，不是登录密码
MAIL_IMAP_HOST=imap.feishu.cn
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.feishu.cn
MAIL_SMTP_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=

# 飞书自建应用（日历用户身份 OAuth）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_REDIRECT_URI=http://localhost:3000/callback
