# NovaSecretary 环境配置模板（复制为 .env 使用）

# ==== 模型配置（OpenAI 兼容协议）====
# 示例1：Ollama 本地
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.7

# 示例2：DeepSeek（切换时改上面的 base_url/api_key/model）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=你的key
# LLM_MODEL=deepseek-chat

# ==== VL 视觉模型（多模态看图，可选）====
# 未配置时，Agent 识别看图意图会友好提示，不强制走 OCR
VL_ENABLED=false
VL_BASE_URL=http://localhost:11434/v1
VL_API_KEY=ollama
VL_MODEL=qwen2.5-vl:7b

# ==== 联网搜索（Tavily）====
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true

# ==== MCP ====
# MCP 配置存在 SQLite，此处仅留默认进程相关
MCP_MAX_CONCURRENT=5

# ==== 存储 ====
# 留空则用系统 AppData 路径
# DB_PATH=

# ==== 白名单目录（分号分隔）====
# 也可在设置面板配置
ALLOWED_DIRS=C:\work;D:\projects
